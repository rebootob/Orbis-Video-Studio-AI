# Orbis Video Studio AI - Backend Configuration Example
# Copy to .env and adjust values for local development.

PROJECT_NAME="Orbis Video Studio AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=orbis_user
POSTGRES_PASSWORD=change_me_in_env_file
POSTGRES_DB=orbis_db

# Overriding Full SQLAlchemy Connection String (optional)
# SQLALCHEMY_DATABASE_URI=postgresql://orbis_user:change_me_in_env_file@localhost:5432/orbis_db
