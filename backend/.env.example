# Orbis Video Studio AI - Backend Configuration Example
# Copy to .env and adjust values for local development.

PROJECT_NAME="Orbis Video Studio AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=orbis_user
POSTGRES_PASSWORD=change_me_in_env_file
POSTGRES_DB=orbis_db

# Object Storage Configuration (S3-compatible / MinIO)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=orbis-assets
OBJECT_STORAGE_ACCESS_KEY=minio_access_key
OBJECT_STORAGE_SECRET_KEY=change_me_minio_secret_key
OBJECT_STORAGE_SECURE=False
MAX_UPLOAD_SIZE_BYTES=524288000


# Overriding Full SQLAlchemy Connection String (optional)
# SQLALCHEMY_DATABASE_URI=postgresql://orbis_user:change_me_in_env_file@localhost:5432/orbis_db
